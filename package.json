{
  "name": "optracard-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:test": "vite --port 3001 --strictPort",
    "preview:test": "vite preview --port 3001 --strictPort",
    "build": "vite build",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "cypress:run": "node scripts/cypress-run.js run",
    "cypress:run:critical": "node scripts/cypress-run.js run --spec cypress/e2e/01-public-pages.cy.ts,cypress/e2e/02-auth-flows.cy.ts,cypress/e2e/03-buyer-cart-checkout.cy.ts,cypress/e2e/08-search.cy.ts,cypress/e2e/09-buyer-promotion-and-reorder.cy.ts,cypress/e2e/12-accessibility-and-access.cy.ts,cypress/e2e/13-auction-smoke.cy.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "npm run build && start-server-and-test preview:test http://localhost:3001 \"npm run cypress:run:critical\"",
    "test:e2e:full": "npm run build && start-server-and-test preview:test http://localhost:3001 \"npm run cypress:run\"",
    "test:e2e:staging": "node scripts/cypress-run.js run --spec cypress/e2e-staging/**/*.cy.ts",
    "test:e2e:deployed": "node scripts/cypress-run.js run --spec cypress/e2e-deployed/**/*.cy.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^5.1.0",
    "autoprefixer": "^10.5.4",
    "cypress": "^16.1.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.26",
    "start-server-and-test": "^3.0.12",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.5"
  }
}
